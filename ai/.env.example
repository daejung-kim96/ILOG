# ===========================
# AI 서비스 포트 설정
# ===========================
EMOTION_AI_PORT=8001
AI_NGINX_HTTP_PORT=80
AI_NGINX_HTTPS_PORT=443

# ===========================
# AI 서버 도메인 (SSL)
# ===========================
AI_SERVER_NAME=ilog.p-e.kr

# ===========================
# SSL 인증서 경로
# ===========================
AI_LETSENCRYPT_PATH=/etc/letsencrypt
AI_SSL_CERT_PATH=/etc/letsencrypt/live/ilog.p-e.kr/fullchain.pem
AI_SSL_CERT_KEY_PATH=/etc/letsencrypt/live/ilog.p-e.kr/privkey.pem

# ===========================
# EMOTION AI 설정
# ===========================
# LLM API 설정 (OpenAI 호환)
LLM_API_BASE=https://gms.ssafy.io/gmsapi/api.openai.com/v1
LLM_API_KEY=S13P32A108-6db4507b-f3dd-40a8-b9ce-43ea70fd1d60
LLM_MODEL=gpt-4o
LLM_TIMEOUT_MS=15000

# 모델 파일 경로 (EC2 서버의 실제 경로)
EMOTION_MODEL_PATH=/data/models/out_roberta_60cls

# 모델 설정
MODEL_VERSION=60cls@local
PIPELINE_ALPHA=0.7
MAX_LEN=256

# ===========================
# VIDEO AI 설정
# ===========================
